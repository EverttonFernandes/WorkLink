name: worklink-api
region: nyc

services:
  - name: worklink-api
    github:
      repo: EvertonFernandes/WorkLink
      branch: main
      deploy_on_push: false
    dockerfile_path: docker/worklink-api.Dockerfile
    source_dir: /
    http_port: 8080
    instance_count: 1
    instance_size_slug: apps-s-1vcpu-0.5gb
    health_check:
      http_path: /actuator/health/readiness
      initial_delay_seconds: 30
      period_seconds: 30
      timeout_seconds: 5
      success_threshold: 1
      failure_threshold: 3
    envs:
      - key: SPRING_PROFILES_ACTIVE
        scope: RUN_TIME
        value: production
      - key: WORKLINK_DATABASE_URL
        scope: RUN_TIME
        type: SECRET
        value: jdbc:postgresql://CHANGE_ME_HOST:25060/CHANGE_ME_DATABASE?sslmode=require
      - key: WORKLINK_DATABASE_USERNAME
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: WORKLINK_DATABASE_PASSWORD
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME
      - key: WORKLINK_JWT_SECRET
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME_STRONG_SECRET
      - key: WORKLINK_FEATURE_LOCAL_AUTHENTICATION_ENABLED
        scope: RUN_TIME
        value: "true"
      - key: WORKLINK_FEATURE_OTP_AUTHENTICATION_ENABLED
        scope: RUN_TIME
        value: "false"
      - key: WORKLINK_FEATURE_SMS_ENABLED
        scope: RUN_TIME
        value: "false"
      - key: WORKLINK_FEATURE_WHATSAPP_ENABLED
        scope: RUN_TIME
        value: "false"
      - key: WORKLINK_FEATURE_GOOGLE_ENABLED
        scope: RUN_TIME
        value: "false"
      - key: WORKLINK_FEATURE_MICROSOFT_ENABLED
        scope: RUN_TIME
        value: "false"
      - key: WORKLINK_FEATURE_FACEBOOK_ENABLED
        scope: RUN_TIME
        value: "false"
      - key: WORKLINK_ACCESS_TOKEN_EXPIRATION_MINUTES
        scope: RUN_TIME
        value: "15"
      - key: WORKLINK_REFRESH_TOKEN_EXPIRATION_DAYS
        scope: RUN_TIME
        value: "30"
      - key: WORKLINK_OTP_EXPIRATION_MINUTES
        scope: RUN_TIME
        value: "5"
      - key: WORKLINK_ENCRYPTION_KEY
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME_STRONG_SECRET
      - key: WORKLINK_OTP_SIGNING_SECRET
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME_STRONG_SECRET
      - key: WORKLINK_SENSITIVE_VALUE_PEPPER
        scope: RUN_TIME
        type: SECRET
        value: CHANGE_ME_STRONG_SECRET
      - key: WORKLINK_PASSWORD_BCRYPT_STRENGTH
        scope: RUN_TIME
        value: "12"
      - key: WORKLINK_MAXIMUM_FAILED_LOGIN_ATTEMPTS
        scope: RUN_TIME
        value: "5"
      - key: WORKLINK_LOGIN_BLOCKING_MINUTES
        scope: RUN_TIME
        value: "15"
      - key: WORKLINK_PASSWORD_RECOVERY_EXPIRATION_MINUTES
        scope: RUN_TIME
        value: "30"
      - key: WORKLINK_PASSWORD_RECOVERY_DELIVERY_MODE
        scope: RUN_TIME
        value: disabled
      - key: WORKLINK_PASSWORD_RECOVERY_SENDER_EMAIL_ADDRESS
        scope: RUN_TIME
        value: no-reply@profissionalperto.local
      - key: WORKLINK_PASSWORD_RECOVERY_RESET_BASE_URL
        scope: RUN_TIME
        value: https://profissionalperto.app/redefinir-senha
      - key: WORKLINK_CORS_ALLOWED_ORIGINS
        scope: RUN_TIME
        value: https://CHANGE_ME
      - key: WORKLINK_FEATURE_STORAGE_ENABLED
        scope: RUN_TIME
        value: "false"
      - key: WORKLINK_TEST_SUPPORT_FIXED_OTP
        scope: RUN_TIME
        value: ""
      - key: WORKLINK_TEST_SUPPORT_PASSWORD_RECOVERY_TOKEN_EXPOSURE_ENABLED
        scope: RUN_TIME
        value: "false"
