#!/usr/bin/env sh
set -eu

protected_branch="refs/heads/main"
requires_validation=false
protected_sha=""

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "$protected_branch" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    requires_validation=true
    protected_sha="$local_sha"
  fi
done

if [ "$requires_validation" != "true" ]; then
  exit 0
fi

if ! command -v make >/dev/null 2>&1; then
  echo "pre-push bloqueado: 'make' nao esta disponivel para executar os gates." >&2
  exit 1
fi

if [ -z "$(git tag --points-at "$protected_sha" --list 'v[0-9]*.[0-9]*.[0-9]*')" ]; then
  echo "pre-push bloqueado: o commit da main precisa de tag semantica vMAJOR.MINOR.PATCH apontando para o mesmo hash." >&2
  echo "commit: $protected_sha" >&2
  exit 1
fi

echo "pre-push: executando make test antes de enviar main..."
make test

echo "pre-push: main validada com testes locais e tag semantica."
