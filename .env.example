# WorkLink local configuration example.
# These values are fictitious and only suitable for local development.

SPRING_PROFILES_ACTIVE=local

WORKLINK_POSTGRES_DATABASE=worklink
WORKLINK_POSTGRES_USERNAME=worklink
WORKLINK_POSTGRES_PASSWORD=change-me-local-postgres-password
WORKLINK_POSTGRES_PORT=5432
WORKLINK_DATABASE_URL=jdbc:postgresql://postgres:5432/worklink
WORKLINK_DATABASE_USERNAME=worklink
WORKLINK_DATABASE_PASSWORD=change-me-local-postgres-password

WORKLINK_REDIS_HOST=redis
WORKLINK_REDIS_PORT=6379
WORKLINK_REDIS_PASSWORD=change-me-local-redis-password

WORKLINK_MINIO_ROOT_USER=worklink
WORKLINK_MINIO_ROOT_PASSWORD=change-me-local-minio-password
WORKLINK_STORAGE_ENDPOINT=http://minio:9000
WORKLINK_STORAGE_BUCKET=worklink-local
WORKLINK_STORAGE_ACCESS_KEY=worklink
WORKLINK_STORAGE_SECRET_KEY=change-me-local-storage-secret-key

WORKLINK_JWT_SECRET=change-me-local-jwt-secret-with-at-least-32-characters
WORKLINK_ACCESS_TOKEN_EXPIRATION_MINUTES=15
WORKLINK_REFRESH_TOKEN_EXPIRATION_DAYS=30
WORKLINK_OTP_EXPIRATION_MINUTES=5
WORKLINK_PROFESSIONAL_PHONE_VERIFICATION_CODE=123456
WORKLINK_PROFESSIONAL_PHONE_VERIFICATION_EXPIRATION_MINUTES=5
WORKLINK_ENCRYPTION_KEY=change-me-local-encryption-key-32chars
WORKLINK_OTP_SIGNING_SECRET=change-me-local-otp-signing-secret
WORKLINK_SENSITIVE_VALUE_PEPPER=change-me-local-sensitive-value-pepper
WORKLINK_PASSWORD_BCRYPT_STRENGTH=12
WORKLINK_MAXIMUM_FAILED_LOGIN_ATTEMPTS=5
WORKLINK_LOGIN_BLOCKING_MINUTES=15
WORKLINK_PASSWORD_RECOVERY_EXPIRATION_MINUTES=30
WORKLINK_OTP_REQUEST_COOLDOWN_SECONDS=45
WORKLINK_AUTHENTICATION_OTP_DELIVERY_MODE=disabled
WORKLINK_PASSWORD_RECOVERY_DELIVERY_MODE=disabled
WORKLINK_PASSWORD_RECOVERY_SENDER_EMAIL_ADDRESS=no-reply@profissionalperto.local
WORKLINK_PASSWORD_RECOVERY_RESET_BASE_URL=https://profissionalperto.app/redefinir-senha
WORKLINK_SMS_PROVIDER_API_KEY=change-me-local-sms-provider-api-key

WORKLINK_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
WORKLINK_FEATURE_LOCAL_AUTHENTICATION_ENABLED=true
WORKLINK_FEATURE_OTP_AUTHENTICATION_ENABLED=false
WORKLINK_FEATURE_SMS_ENABLED=false
WORKLINK_FEATURE_EMAIL_OTP_ENABLED=false
WORKLINK_FEATURE_WHATSAPP_ENABLED=false
WORKLINK_FEATURE_GOOGLE_ENABLED=false
WORKLINK_FEATURE_MICROSOFT_ENABLED=false
WORKLINK_FEATURE_FACEBOOK_ENABLED=false
WORKLINK_FEATURE_STORAGE_ENABLED=true
WORKLINK_TEST_SUPPORT_FIXED_OTP=123456
WORKLINK_TEST_SUPPORT_PASSWORD_RECOVERY_TOKEN_EXPOSURE_ENABLED=false

WORKLINK_SHUTDOWN_PHASE_TIMEOUT=30s
WORKLINK_ASYNC_REQUEST_TIMEOUT=5s
WORKLINK_SERVER_CONNECTION_TIMEOUT=5s
WORKLINK_DATABASE_CONNECTION_TIMEOUT_MS=3000
WORKLINK_DATABASE_VALIDATION_TIMEOUT_MS=1000
WORKLINK_EXTERNAL_HTTP_CONNECTION_TIMEOUT=2s
WORKLINK_EXTERNAL_HTTP_READ_TIMEOUT=5s
WORKLINK_EXTERNAL_HTTP_MAX_RETRY_ATTEMPTS=2

